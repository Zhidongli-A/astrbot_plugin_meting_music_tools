{
  "api_url": {
    "description": "MetingAPI 地址",
    "type": "string",
    "hint": "NodeApi 格式的 MetingAPI 地址，以 / 结尾",
    "default": "https://api.qijieya.cn/meting/"
  },
  "search_result_count": {
    "description": "搜索结果显示数量",
    "type": "int",
    "hint": "搜索结果显示的歌曲数量，范围: 5-30",
    "default": 10,
    "minimum": 5,
    "maximum": 30
  },
  "max_file_size": {
    "description": "最大文件大小 (MB)",
    "type": "int",
    "hint": "下载歌曲的最大文件大小，范围: 10-200MB",
    "default": 80,
    "minimum": 10,
    "maximum": 200
  }
}
